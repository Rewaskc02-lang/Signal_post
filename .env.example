# Brønnøysundregistrene (Brreg) API Configuration
# Note: Brreg is a free public registry and does NOT require API keys.

# Base URLs
BRREG_ENHET_BASE_URL=https://data.brreg.no/enhetsregisteret/api/enheter
BRREG_REGNSKAP_BASE_URL=https://data.brreg.no/regnskapsregisteret/regnskap
BRREG_BULK_DOWNLOAD_URL=https://data.brreg.no/enhetsregisteret/api/enheter/lastned

# Client & Network Settings
BRREG_REQUEST_TIMEOUT_SECONDS=10.0
BRREG_MAX_CONCURRENCY=15
BRREG_MAX_RETRIES=3
BRREG_RETRY_BACKOFF_FACTOR=0.5

# Database Settings
SQLITE_DB_PATH=signalpost.db

# Optional External API Keys (Empty placeholders only - never commit real keys)
OPENROUTER_API_KEY=
BREETH_API_KEY=

# LLM Summary Settings (Optional)
ENABLE_LLM_SUMMARY=false
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash
